# ============================================================
# Actus 环境变量配置模板
# 复制此文件为 .env 并根据实际环境修改
# cp .env.example .env
# ============================================================

# ---------- Compose 项目设置 ----------
COMPOSE_PROJECT_NAME=actus
DOCKER_NETWORK_NAME=actus-net

# ---------- 端口映射 ----------
UI_PORT=80
API_PORT=8000
REDIS_PORT=6379

# ---------- 时区 ----------
# Docker 容器统一时区（示例：Asia/Shanghai, UTC）
TZ=Asia/Shanghai

# ---------- Python 包镜像源（可选） ----------
# 构建 api / sandbox 镜像时使用；如需改回官方 PyPI，可设为 https://pypi.org/simple
PYTHON_PACKAGE_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password     # ⚠️ 请修改为强密码
POSTGRES_DB=manus

# ---------- Redis ----------
REDIS_DB=0

# ---------- MinIO (S3 兼容对象存储，必填) ----------
MINIO_ENDPOINT=s3.example.com                        # ⚠️ 你的 MinIO / S3 地址
MINIO_ACCESS_KEY=replace-with-minio-access-key       # ⚠️ 你的 Access Key
MINIO_SECRET_KEY=replace-with-minio-secret-key       # ⚠️ 你的 Secret Key
MINIO_REGION=
MINIO_SECURE=true
MINIO_BUCKET_NAME=a2a-mcp

# ---------- 应用配置 ----------
ENV=production
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-strong-random-string   # ⚠️ 请修改（可用 openssl rand -hex 32 生成）

# ---------- CORS 配置 ----------
CORS_ORIGINS=http://localhost:3000,http://localhost    # 逗号分隔多个来源，Docker 部署需包含 http://localhost
MAX_REQUEST_BODY_SIZE=524288000        # 请求体限制，默认 500MB

# ---------- LangSmith 调试追踪（可选） ----------
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxx                  # ⚠️ 从 smith.langchain.com 获取
# LANGCHAIN_PROJECT=actus                              # 项目名称，可自定义

# ---------- Skill Creator（可选） ----------
GITHUB_TOKEN=

# ---------- 沙箱配置 ----------
SANDBOX_IMAGE=actus-sandbox:latest
# 设为 true 可在沙箱镜像中安装 faster-whisper（约 +500MB），启用 audio.provider=sandbox_whisper
INSTALL_WHISPER=false
SANDBOX_NAME_PREFIX=actus-sb
SANDBOX_TTL_MINUTES=60
SANDBOX_CHROME_ARGS=
SANDBOX_HTTP_PROXY=
SANDBOX_HTTPS_PROXY=
SANDBOX_NO_PROXY=

# ---------- Memory 系统 (M1 PR-6A：文件为事实源) ----------
# host 上真实的 memory 根目录，docker bind 的 source 端。
# **必须填写宿主机绝对路径**（例如 `/Users/yourname/.actus/memory` /
# `/var/lib/actus/memory`），不要写 `~/.actus/memory` —— Docker daemon 读取的是
# host 路径，`~` 在 api 容器里会被误展开成 `/root/...`。
# 部署者首次启动前必须 `mkdir -p` 出来；否则 docker compose up 时 api 容器挂载失败。
MEMORY_ROOT_HOST=/absolute/path/to/actus-memory
# api 容器内部视角的根目录；FsMemoryWriter 以此路径落盘，docker-compose.yml
# 把它 bind 到 MEMORY_ROOT_HOST。**一般无需改动。**
MEMORY_ROOT_CONTAINER=/app/data/memory
# sandbox 容器内部看到的 mount 点。agent 通过 `file_read /workspace/.memory/...`
# 读取用户 memory；路径固定以便 prompt/tools 约束。
SANDBOX_MEMORY_MOUNT_TARGET=/workspace/.memory
# sandbox 侧是否执行 read-only bind mount。PR-6A 起默认 true。
# 当 host 端 MEMORY_ROOT_HOST 权限/路径未就绪时可临时置 false，agent 降级为
# 只能通过 memory_search 召回（无 file_read 物理文件）。
SANDBOX_MEMORY_MOUNT_ENABLED=true
# 非 root 运行 api 的 uid/gid（rootless 改造 follow-up PR）。M1 PR-6A 不强制使用，
# 保留变量给未来 docker-compose.yml 的 `user:` 字段；启用前必须：
#   sudo chown -R ${ACTUS_UID}:${ACTUS_GID} ${MEMORY_ROOT_HOST}
# ACTUS_UID=1000
# ACTUS_GID=1000

# ---------- C3 Mailbox Supervisor (PR-3a / PR-5 flip / PR-6 legacy retire) ----------
# 历史背景：PR-3a 落地时 default=false（影子模式），PR-5 翻成 true 由
# MailboxSupervisor 接管 child→parent 终态分发。**PR-6 (spec §11.7 + §18
# Retirement Addendum) 彻底退役 legacy plane**：mailbox 是唯一受支持的
# control plane，SessionService 永远写 ``subagent_control_plane='mailbox'``，
# main.py 启动无条件构建 SupervisorRegistry。
#
# **MAILBOX_SUPERVISOR_ENABLED 现在是 inert** — 设回 false 不再 downgrade
# 新 child 到 legacy 平面（§11.6 rollback runbook 已废弃），同时 alembic
# migration ``c3pr6_retire_legacy_control_plane`` 会把任何残留的 legacy
# 行（含 NULL plane）一次性升级为 mailbox。如确需回滚 mailbox 实现本身，
# 只能 pre-migration DB snapshot 还原。
#
# 变量仍保留 default=true 是给少量仍读 flag 的兼容代码（例如
# ``AgentTaskRunner._mailbox_supervisor_enabled`` 读 settings 后透传给
# runner，production 路径走 True 分支；测试可以显式注入 False 触发兼容
# 分支测试）。一次性 cleanup PR 会把变量整体拿掉。
MAILBOX_SUPERVISOR_ENABLED=true   # C3 PR-6 — flag inert; mailbox plane mandatory (spec §11.7)
# 部署 pod 标识。空 = 退化到 socket.gethostname()。生产请用 k8s downward API
# 注入 (e.g. metadata.name)，便于 XAUTOCLAIM 跨 pod 追踪 PEL 所有权。
MAILBOX_POD_ID=
# 可选——以下与 spec §4.3 默认值同步，一般无需改动：
# MAILBOX_XREADGROUP_BLOCK_MS=1000
# MAILBOX_XREADGROUP_COUNT=32

# ---------- C2 CoordinatorTaskRunner v1 ----------
# C2 Coordinator parallel-work-unit dispatch. Currently OFF (PR-9a scaffolds only).
# Set true only after PR-9b infrastructure ships AND the acceptance gate in
# CONTRIBUTING.md "C2 PR-9 Acceptance" passes. While false, planner does not
# emit parallel_work_units; coordinator emit sites silently no-op.
ACTUS_C2_COORDINATOR_ENABLED=true
# C2-full S4 agent-team named bundles (default OFF — flag-ready, not prod-flipped)
ACTUS_C2_AGENT_TEAMS_ENABLED=false
# Metrics endpoint auth token (B5 observability + C2 coordinator runbooks).
# Empty → /api/v1/metrics 404s (endpoint disabled). Set a non-empty secret to
# enable the Prometheus scrape used by docs/runbooks/c2-coordinator-live-acceptance.md
# and the perf-sampling CLI. App reads this ACTUS_-prefixed name OR the unprefixed
# METRICS_ENDPOINT_TOKEN (core/config.py AliasChoices); the perf CLI defaults to
# $ACTUS_METRICS_ENDPOINT_TOKEN.
ACTUS_METRICS_ENDPOINT_TOKEN=
# C2 coordinator hard caps（可选 override；注释值 = 代码默认值 coordinator_limits.py）。
# 全部必须为正数；非法/非正值启动时 WARNING 并回退默认。
# 注意不变式：MAX_WALLCLOCK_SECONDS_PER_CHILD 必须 < 600（child 内部 cap 先于
# parent observer timeout 触发，否则 budget envelope 发出时 parent 已不在等）。
# ACTUS_COORDINATOR_MAX_WORK_UNITS_PER_RUN=5
# ACTUS_COORDINATOR_MAX_TOOL_CALLS_PER_CHILD=25
# ACTUS_COORDINATOR_MAX_TOKEN_COST_USD_PER_CHILD=0.50
# ACTUS_COORDINATOR_MAX_WALLCLOCK_SECONDS_PER_CHILD=300
# ACTUS_COORDINATOR_MAX_TOTAL_TOKEN_COST_USD_PER_RUN=2.00
# ACTUS_COORDINATOR_MAX_TOTAL_WALLCLOCK_SECONDS_PER_RUN=900
# ACTUS_COORDINATOR_MAX_CONCURRENT_RUNS_PER_USER=2
# ACTUS_COORDINATOR_MAX_TOKEN_COST_USD_PER_USER_PER_DAY=50.00

# ---------- Checkpointer 连接池（可选，有默认值） ----------
# CHECKPOINTER_POOL_MIN_SIZE=2           # 启动时预创建的连接数
# CHECKPOINTER_POOL_MAX_SIZE=10          # 最大连接数
# CHECKPOINTER_POOL_TIMEOUT=30.0         # 连接等待超时（秒）

# ---------- 前端 API 地址（构建时注入，必须是浏览器可达地址）----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ---------- SSH 隧道（移动端远程访问，可选） ----------
# 默认不会启动 tunnel 服务；如需启用，请使用：
# docker compose --profile tunnel up -d
# 启用后，tunnel 容器会建立 SSH 反向隧道，将 API 暴露到云服务器
# TUNNEL_REMOTE_HOST=1.2.3.4                              # ⚠️ 云服务器公网 IP（启用 tunnel 时必填）
TUNNEL_REMOTE_PORT=18082                                   # 云服务器上暴露的端口
TUNNEL_SSH_USER=root                                       # SSH 用户名
TUNNEL_SSH_PORT=22                                         # SSH 端口
TUNNEL_SSH_KEY_PATH=./tunnel/id_rsa                        # SSH 私钥路径

# ---------- 可选：微信 OAuth ----------
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URI=
# WECHAT_FRONTEND_REDIRECT_URI=
