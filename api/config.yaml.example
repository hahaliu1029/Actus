# Actus 运行时配置模板
# 本地开发可复制为 api/config.yaml；Docker 运行时请写入 /app/data/config.yaml
# cp config.yaml.example config.yaml

llm_config:
  base_url: https://api.deepseek.com/    # LLM API 地址
  api_key: ''                             # 你的 LLM API Key
  model_name: deepseek-reasoner           # 模型名称
  # provider: deepseek_reasoner          # A7: 显式声明 provider_id (kimi_k2 / kimi_k2_6 / deepseek_chat / deepseek_reasoner / dashscope_qwen / dashscope_qwen_vl / anthropic_compat / gemini_compat / minimax / glm / openai_official / generic_openai). 未填按 base_url 启发式推断，K2.6 必须显式声明不会被自动识别。
  #                                      # A7 P1 (2026-04-23): DashScope 拆 text / vl 两 profile。base_url 命中 DashScope / Anthropic / Gemini 三家之一但 model_name 不在 allowlist (如 qwen3.5-plus / Opus 4.7 / Gemini 2.5 Pro) → heuristic 返回 generic_openai (= 今天行为)。MiniMax / GLM 无 model-name allowlist，直接按 base_url 匹配。显式 provider=<registered_id> 会绕过 allowlist 验证，仅建议在明确对齐时使用。
  temperature: 0.7
  max_tokens: 8192
  # api_type: chat_completions            # API 类型: chat_completions / responses / auto
  # supports_response_format: true        # 部分兼容 API 不支持 response_format 参数，设为 false 可跳过
  # supports_vision: true                 # 模型是否支持视觉/多模态（图片嵌入），非视觉模型设为 false 后强制使用 MCP 工具分析图片
  # supports_pdf_input: false             # 是否支持原生 PDF 文件输入（需要模型支持，如 gpt-4o）
  # timeout_seconds: 300.0                # D5.1: 单次 LLM 调用硬超时（秒）。0 表示关闭 wait_for 包装（仅调试用）；其它值会被 adapter 的 _agenerate/_astream 包成 asyncio.wait_for，超时抛 ServerRequestsError 让 LangGraph RetryPolicy 接管重试。代码默认 120s；长上下文/多模态/复杂推理场景推荐 300s，配合下方 agent_config.execution 的 idle/total 超时同步调整。同时作为 httpx read/write/pool 阶段上限。
  # connect_timeout_seconds: 60.0         # D5.2: httpx connect 阶段（TCP+TLS 握手）专用超时（秒）。与 timeout_seconds 独立是因为 OpenAI SDK 默认只给 connect 5s，跨境慢网/连接池复用失效/DNS 漂移等场景下 TLS 握手会直接被 5s 砍掉，提 timeout_seconds 毫无作用（外层 asyncio.wait_for 根本来不及生效就被 httpcore.ConnectTimeout 冒出来）。代码默认 60s，上界 300s 留给极端环境；真正死端点仍能在 1 分钟内快速失败。
  # context_overflow_guard_enabled: false  # 开启上下文超限治理
  # token_estimator: hybrid               # token 估算策略: char(最快) / hybrid(推荐) / provider_api(需安装 tiktoken)
  # token_safety_factor: 1.15             # token 估算安全系数
  # tool_compress_trigger_ratio: 0.75    # Phase 1 工具结果压缩触发比例
  # target_ratio: 0.65                   # Level 2 压缩后目标水位
  # summary_max_chars: 16000             # 摘要上限字符数
  # system_prompt_max_tokens: 10000      # B5 C9 / M2-PR0: system prompt token 预算上限（PromptAssembler 硬封顶 + effective_window 基数）；M2-PR0 从 3500 提到 10000 为 memory sections 留出空间

# OpenAI 官方 API 示例（gpt-5.4，推荐）
# llm_config:
#   base_url: https://api.openai.com/v1
#   api_key: YOUR_OPENAI_API_KEY
#   model_name: gpt-5.4
#   temperature: 0.7
#   max_tokens: 8192
#   timeout_seconds: 300.0                # D5.1: 单次 LLM 调用硬超时（秒）。api_type=auto 时注意 primary+fallback 总预算 > 200s 会触发 budget warning（代码默认 600s watchdog / 3 graph retries）。若设 300s 需同步把 agent_config.execution.total_timeout_seconds 拉到 900s+
#   api_type: auto
#   supports_response_format: true

# OpenAI 官方 API 示例（gpt-5.4-pro，仅支持 Responses API）
# llm_config:
#   base_url: https://api.openai.com/v1
#   api_key: YOUR_OPENAI_API_KEY
#   model_name: gpt-5.4-pro
#   temperature: 0.7
#   max_tokens: 8192
#   timeout_seconds: 300.0                # D5.1: 单次 LLM 调用硬超时（秒）
#   api_type: responses
#   supports_response_format: true

agent_config:
  max_iterations: 100                     # Agent 最大迭代次数
  max_retries: 3                          # 工具调用最大重试次数
  max_search_results: 10                  # 搜索结果数量
  # B11 快捷命令层（前端 slash commands）。三 flag 出厂关闭，翻转是部署决策。
  slash_commands:
    enabled: false                    # FE 总开关：关=无拦截/无菜单
    skill_commands_enabled: false     # enabled skill 自动暴露为 /<slug> prompt 展开命令
    manual_compaction_enabled: false  # 开放 POST /sessions/{id}/compactions 端点
  skill_selection:
    base_threshold: 3
    short_message_max_chars: 24
    llm_trigger_token_count: 4
    continuation_llm_enabled: true
    continuation_llm_timeout_seconds: 3.0
    continuation_llm_cache_size: 128
    ask_user_min_attempt_rounds_per_step: 3
    step_skill_lock_enabled: true
    step_skill_reselect_unknown_tool_threshold: 3
    step_skill_reselect_max_per_step: 1
    available_tool_summary_token_budget: 500
    unknown_tool_candidate_limit: 10
    continuation_phrases:
      - "继续"
      - "请继续"
      - "继续一下"
      - "继续吧"
      - "接着"
      - "下一步"
      - "好的"
      - "好"
      - "行"
      - "嗯"
      - "收到"
      - "ok"
      - "okay"
      - "go on"
      - "next"
      - "please continue"
      - "proceed"
    # continuation_patterns 使用 Python re 语法
    # 注意 YAML 中反斜杠需要转义，例如 "\\s"
    continuation_patterns:
      - "^(请)?继续(一下|吧|下去)?$"
      - "^(好的?[,，\\s]*)?(继续|接着)$"
      - "^(ok|okay)([,\\s]+(go on|continue))?$"
  memory:
    summary_enabled: true
    # summary_model: ""                   # 可选：覆盖 summarizer 的模型名。留空则复用 llm_config.model_name。
    # summary_timeout_seconds: 30.0       # D5.1: summarizer 单次调用硬超时（秒）。三态语义：（1）注释掉/省略本字段 → 使用模型默认值 30s（**不自动继承** llm_config.timeout_seconds）；（2）显式写数值（如 5.0）→ 覆盖；（3）显式写 null → 继承 llm_config.timeout_seconds。summarizer 无工具、prompt 短，通常比主 Agent 更短；默认 30s 是经验值（15s 预期完成 + 2x 缓冲）。
    summary_max_rounds: 5
    summary_token_budget: 2000
    summary_min_steps: 1
    context_anchor_enabled: true
    compact_keep_summary: true
    # Flush 调度
    flush_enabled: false
    flush_min_steps: 2
    flush_min_new_tokens: 3000
    flush_max_retries: 3
    flush_circuit_breaker_threshold: 3
    # Embedding（记忆向量化，独立于 skill embedding）
    embedding_enabled: false
    embedding_api_base: ""          # OpenAI 兼容 API base URL
    embedding_api_key: ""           # API key
    embedding_dim: 512              # 必须与 DB pgvector 列维度一致
    embedding_model: "text-embedding-3-small"
    embedding_circuit_breaker_threshold: 3    # 连续失败次数后熔断
    embedding_circuit_breaker_recovery_seconds: 300.0  # 熔断恢复时间（秒）
    # C7: 混合检索与排序
    half_life_days: 30                # 时间衰减半衰期（天）
    mmr_lambda: 0.7                   # MMR 多样性参数 (0=纯多样性, 1=纯相关性)
    hybrid_alpha: 0.7                 # 向量/文本混合权重 (C7 仅占位不参与计算, C8 生效)
    # --- B8 query-time 记忆召回（planner 前置召回）------------------------
    # recall_mode: off | shadow | on（默认 off = 完全关闭，prompt byte-identical）
    #   shadow = 检索+telemetry 照跑但不注入 prompt（观察分布、校准阈值；
    #            多付一次 embed + pgvector 查询成本）
    #   on     = 注入 planner 系统提示的 recalled_memory 围栏段
    # 翻 on 前置判据（guardrails，观察 shadow 期 telemetry——
    # logger `actus.memory_recall` INFO 一行 JSON / metrics memory_recall_total）：
    #   timeout_rate < 1%；(error + embed_unavailable) 率 < 1%；
    #   latency_p95 < 600ms（< timeout 0.75s 留余量）；
    #   empty 率无硬阈值（取决于记忆库密度，人工判断）；
    #   人工抽样 recall 事件的 chunk_ids 反查内容，确认无明显无关召回。
    # 回退 = 改回 off（纯读路径，无 schema/数据迁移）。
    # ⚠ 安全注记：召回缓存以**明文**（截断 120 字符）存 Redis
    #   （key 前缀 mem_recall:）——前提是私有内网 Redis（compose 默认拓扑）。
    #   共享/暴露部署必须启用 Redis auth/ACL/TLS，否则保持 recall_mode: off。
    # recall_mode: "off"
    # recall_top_k: 5                  # 检索上限（渲染受 section 预算再截）
    # recall_threshold: 0.35           # cosine 阈值（512-dim 分布未标定，shadow 期校准）
    # recall_timeout_seconds: 0.75     # 整体召回预算，超时 fail-open 无注入
    # recall_cache_ttl_seconds: 86400  # session 级召回缓存 TTL
    # recall_query_max_chars: 2000     # query 素材总长上限
  # execution:                        # 执行健康监控（ExecutionWatchdog 双层超时）
  #   total_timeout_seconds: 900.0    # 整图执行总超时（秒）。代码默认 600s；配合 llm_config.timeout_seconds=300s 时建议 900s（300 x 3 graph retries）
  #   idle_timeout_seconds: 300.0     # 空闲无进度事件超时（秒）。代码默认 120s；非流式 LLM 调用需 >= llm_config.timeout_seconds，否则 watchdog 会先触发
  #   max_same_tool_failures: 3       # 同签名工具最大连续失败数

mcp_config:
  mcpServers:
    # 示例：高德地图 MCP 服务器
    # amap-maps-streamableHTTP:
    #   transport: streamable_http
    #   enabled: true
    #   description: null
    #   env: null
    #   command: null
    #   args: null
    #   url: https://mcp.amap.com/mcp?key=YOUR_AMAP_KEY
    #   headers: null
    #
    # 示例：Jina MCP 服务器
    # jina-mcp-server:
    #   transport: streamable_http
    #   enabled: true
    #   description: null
    #   env: null
    #   command: null
    #   args: null
    #   url: https://mcp.jina.ai/v1
    #   headers:
    #     Authorization: Bearer YOUR_JINA_API_KEY
    #   server_name: jina-mcp-server

a2a_config:
  a2a_servers: []

skill_risk_policy:
  mode: off

# Skill 生态说明（v2）：
# - Skill 权威源位于 API 容器中的 /app/data/skills（可通过 SKILLS_ROOT_DIR 调整）
# - 目录型 Skill 会在会话启动时预同步到 sandbox（默认 /home/ubuntu/workspace/.skills，可通过 SKILL_SANDBOX_BUNDLE_ROOT 调整）
# - 用户偏好仍存储在 user_tool_enablements（tool_type=skill）
# - 请在前端「设置 -> Skill 生态」中安装和管理 Skill

# Skill embedding configuration (optional, disabled by default)
# skill_embedding:
#   enabled: false
#   api_base: "https://api.openai.com/v1"
#   api_key: ""
#   model: "text-embedding-3-small"
#   dimensions: 256

# 文件理解配置（file_view 工具）
# file_understanding:
#   vision_fallback:                 # 非多模态主模型时的视觉 fallback（独立配置，可使用不同 provider）
#     enabled: false
#     base_url: ""                   # 留空则复用主 LLM 的 base_url
#     api_key: ""                    # 留空则复用主 LLM 的 api_key
#     model_name: ""                 # 如 gpt-4o-mini
#     api_type: "chat_completions"   # chat_completions / responses / auto
#   audio:
#     provider: "disabled"           # sandbox_whisper | openai_api | disabled
#     openai_api_key: ""
#     openai_base_url: "https://api.openai.com/v1"
#     openai_model: "whisper-1"
#   video:
#     max_keyframes: 20
#     extract_audio: true
#     frame_strategy: "scene"        # scene | uniform
#     scene_threshold: 0.3           # 场景切换检测阈值（0~1）

# R2 CS2: tool runtime 配置（Layer 2 wrapper guard + Layer 1 SmartApprove 超时 + R4 variant 白名单）
# tool_runtime:
#   max_wrapper_output_bytes: 1048576   # 1 MiB — Layer 2 wrapper 返回的 content 超过此字节数会被转成 AllowError(wrapper_output_too_large)，防止内存尖峰
#   smart_approve_timeout_seconds: 15   # Layer 1 Stage P.2 SmartApprove LLM 调用超时（秒）。超时 fail-open（当作 allow），避免 LLM 挂死整个 tool 调用
#   enabled_outcome_variants:           # R4 CS3: ToolOutcome variant 白名单. 新 variant 上线 3 步: (1) deploy 新 projector → (2) 加到此白名单 → (3) 启用 wrapper
#     - allow_success
#     - allow_error
#     - denied
#     - asked
#     - passthrough
#   # B1 streaming tool execution (all default false; see docs/superpowers/specs/2026-07-02-b1-streaming-tool-execution-design.md §8 flip conditions)
#   tool_running_events_enabled: false   # emit running status at tool execution start
#   tool_concurrency_enabled: false      # in-batch concurrency window (safe tools only)
#   tool_max_concurrency: 3
#   llm_tool_call_streaming_enabled: false        # llm_node astream + collector (B1-2)
#   llm_incremental_calling_events_enabled: false # provisional CALLING mid-stream (requires streaming flag)
#   tool_display_metadata_enabled: false # B10: 工具卡 display policy 元数据（CALLING/RUNNING 提前携带 tool_source + display_icon/read_only/destructive；OFF 时这三个 display 键序列化为 null、既有字段不变）
#   extension_probe_enabled: false   # B9 扩展健康探测（后台循环+手动 probe；见 specs/2026-07-04-b9-runtime-console-design.md §9）
#   extension_stats_enabled: false   # B9 扩展调用统计（react_graph 埋点+Redis；同上 §9）
